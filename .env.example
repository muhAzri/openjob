# Server
HOST=localhost
PORT=5000

# PostgreSQL (read automatically by `pg` and by node-pg-migrate)
PGUSER=developer
PGPASSWORD=supersecretpassword
PGDATABASE=openjob
PGHOST=localhost
PGPORT=5432

# Required by node-pg-migrate CLI
DATABASE_URL=postgres://developer:supersecretpassword@localhost:5432/openjob

# JWT
ACCESS_TOKEN_KEY=replace_with_a_long_random_secret_for_access_token
REFRESH_TOKEN_KEY=replace_with_a_long_random_secret_for_refresh_token
ACCESS_TOKEN_AGE=10800

# Redis (caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=3600

# RabbitMQ (message queue)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# AMQP_URL can be used as an alternative, e.g. amqp://guest:guest@localhost:5672
APPLICATIONS_QUEUE=applications_queue

# SMTP (new application notification email, sent by the consumer)
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=replace_with_smtp_user
MAIL_PASSWORD=replace_with_smtp_password
