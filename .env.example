# Server
HOST=localhost
PORT=5000

# PostgreSQL (read automatically by `pg` and by node-pg-migrate)
PGUSER=developer
PGPASSWORD=supersecretpassword
PGDATABASE=openjob
PGHOST=localhost
PGPORT=5432

# Required by node-pg-migrate CLI
DATABASE_URL=postgres://developer:supersecretpassword@localhost:5432/openjob

# JWT
ACCESS_TOKEN_KEY=replace_with_a_long_random_secret_for_access_token
REFRESH_TOKEN_KEY=replace_with_a_long_random_secret_for_refresh_token
ACCESS_TOKEN_AGE=10800
