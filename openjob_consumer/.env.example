# PostgreSQL — must point to the same database as openjob_api
# (read automatically by `pg`)
PGUSER=developer
PGPASSWORD=supersecretpassword
PGDATABASE=openjob
PGHOST=localhost
PGPORT=5432

# RabbitMQ (message queue - must match the openjob_api instance)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# AMQP_URL can be used as an alternative, e.g. amqp://guest:guest@localhost:5672
APPLICATIONS_QUEUE=applications_queue

# SMTP (new application notification email)
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=replace_with_smtp_user
MAIL_PASSWORD=replace_with_smtp_password
