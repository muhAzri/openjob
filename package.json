{
  "name": "openjob",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx watch src/server.ts",
    "consumer": "node dist/consumer/index.js",
    "consumer:dev": "tsx watch src/consumer/index.ts",
    "migrate": "node-pg-migrate -j ts",
    "migrate:up": "node-pg-migrate -j ts up",
    "migrate:down": "node-pg-migrate -j ts down",
    "migrate:create": "node-pg-migrate -j ts create",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
